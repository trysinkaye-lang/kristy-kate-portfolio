# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Resend API key and an address on a verified sending domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional; defaults to the portfolio owner's existing email.
CONTACT_TO_EMAIL=trysinkaye@gmail.com

# Optional persistent rate limiting across Vercel instances.
# Set BOTH values. A partially configured/unavailable store fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

